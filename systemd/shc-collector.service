[Unit]
Description=SHC Monitor host collector
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=shc-monitor
Group=shc-monitor
RuntimeDirectory=shc-monitor
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
Environment=SHC_COLLECTOR_TOKEN_FILE=/etc/shc-monitor/collector-token
ExecStart=/opt/shc-monitor/collector/run.sh
Restart=on-failure
RestartSec=3
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/run/shc-monitor

[Install]
WantedBy=multi-user.target
