[Unit]
Description=SHC Monitor host collector
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=hailsa
Group=hailsa
RuntimeDirectory=shc-monitor
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
Environment=SHC_COLLECTOR_TOKEN_FILE=/etc/shc-monitor/collector-token
ExecStart=/opt/shc-monitor/collector/run.sh
Restart=on-failure
RestartSec=3
RuntimeDirectoryPreserve=restart
UMask=0007
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=false
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/run/shc-monitor /home/hailsa

[Install]
WantedBy=multi-user.target
