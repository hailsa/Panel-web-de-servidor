# Paths used by Docker Compose on the Debian host.
SHC_CONFIG_FILE=/etc/shc-monitor/config.yml
SHC_COLLECTOR_TOKEN_FILE=/etc/shc-monitor/collector-token
SHC_RUNTIME_DIR=/run/shc-monitor
SHC_DATA_DIR=/var/lib/shc-monitor

# The dashboard must remain local; Apache is the public-facing process.
SHC_DASHBOARD_BIND=127.0.0.1
SHC_DASHBOARD_PORT=8085

